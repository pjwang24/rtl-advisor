[tasks]
positive
bad_reset
bad_state
bad_grant

[options]
mode prove
depth 16
expect pass

[engines]
abc pdr

[script]
plugin -i /opt/oss-cad-suite/share/yosys/plugins/slang.so
read_slang --top prim_arbiter_ppc -G N=4 -G DW=8 -D SYNTHESIS -I . prim_util_pkg.sv prim_leading_one_ppc.sv prim_arbiter_ppc.sv
read_slang --top prim_arbiter_tree -G N=4 -G DW=8 -D SYNTHESIS -I . prim_arbiter_tree.sv
positive: read_verilog -formal -sv opentitan_arbiter_p2_miter.sv
bad_reset: read_verilog -formal -sv -D MUTATION_KIND=1 opentitan_arbiter_p2_miter.sv
bad_state: read_verilog -formal -sv -D MUTATION_KIND=2 opentitan_arbiter_p2_miter.sv
bad_grant: read_verilog -formal -sv -D MUTATION_KIND=3 opentitan_arbiter_p2_miter.sv
prep -top opentitan_arbiter_p2_miter

