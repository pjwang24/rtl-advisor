{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtl-advisor.local/schemas/rtl-advisor-workflow-batch-authorization-v1.schema.json",
  "title": "RTL Advisor Workflow Batch Authorization V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "document_type", "batch_id", "request_semantic_hash", "authorized_through", "basis", "candidate_selection", "issued_at", "semantic_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "rtl-advisor-workflow-batch-authorization-v1"},
    "document_type": {"const": "rtl-advisor.workflow.batch-authorization"},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9a-f]{20}$"},
    "request_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorized_through": {"enum": ["review", "candidate", "verify", "measure"]},
    "basis": {"type": "object"},
    "candidate_selection": {"type": ["object", "null"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
