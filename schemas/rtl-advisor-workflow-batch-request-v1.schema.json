{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtl-advisor.local/schemas/rtl-advisor-workflow-batch-request-v1.schema.json",
  "title": "RTL Advisor Workflow Batch Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema", "document_type", "batch_id", "manifest_semantic_hash", "items", "semantic_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "schema": {"const": "rtl-advisor-workflow-batch-request-v1"},
    "document_type": {"const": "rtl-advisor.workflow.batch-request"},
    "batch_id": {"type": "string", "pattern": "^batch-[0-9a-f]{20}$"},
    "manifest_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
