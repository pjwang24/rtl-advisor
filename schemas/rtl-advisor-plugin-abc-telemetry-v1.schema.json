{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rtl-advisor-plugin-abc-telemetry-v1.schema.json",
  "title": "RTL Advisor plugin A/B/C telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "experiment_id", "runs"],
  "properties": {
    "schema": {"const": "rtl-advisor-plugin-abc-telemetry-v1"},
    "experiment_id": {"const": "plugin-abc-v1"},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "arm", "repetition", "input_tokens", "output_tokens",
          "total_tokens", "wall_time_seconds", "task_completed"
        ],
        "properties": {
          "arm": {"enum": ["A", "B", "C"]},
          "repetition": {"type": "integer", "minimum": 1},
          "attempt": {"type": "integer", "minimum": 1},
          "input_tokens": {"type": "integer", "minimum": 0},
          "output_tokens": {"type": "integer", "minimum": 0},
          "total_tokens": {"type": "integer", "minimum": 0},
          "wall_time_seconds": {"type": "number", "minimum": 0},
          "task_completed": {"type": "boolean"},
          "admitted_to_evaluation": {"type": "boolean"},
          "exclusion_reason": {"type": "string", "minLength": 1},
          "cached_input_tokens": {"type": "integer", "minimum": 0},
          "cache_write_input_tokens": {"type": "integer", "minimum": 0},
          "reasoning_output_tokens": {"type": "integer", "minimum": 0},
          "exit_code": {"type": "integer"},
          "thread_id": {"type": ["string", "null"]},
          "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result_path": {"type": "string"},
          "events_path": {"type": "string"},
          "command_count": {"type": "integer", "minimum": 0},
          "command_wave_count": {"type": "integer", "minimum": 0},
          "command_categories": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "command_output_bytes": {"type": "integer", "minimum": 0},
          "agent_message_bytes": {"type": "integer", "minimum": 0},
          "output_bytes": {"type": "integer", "minimum": 0},
          "skill_source": {"const": "workspace_path"},
          "skill_path": {"type": "string", "minLength": 1},
          "skill_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "validation_error": {"type": "string"},
          "provenance_path": {"type": "string", "minLength": 1},
          "audit_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
