{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RTL Advisor strict Codex A/B result transport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment_id",
    "arm",
    "repetition",
    "model",
    "reasoning_effort",
    "manifest_sha256",
    "cases"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "rtl-advisor-plugin-abc-arm-result-v1"
    },
    "experiment_id": {
      "type": "string",
      "const": "plugin-abc-v1"
    },
    "arm": {
      "type": "string",
      "enum": ["A", "B"]
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "model": {
      "type": "string",
      "const": "gpt-5.6-sol"
    },
    "reasoning_effort": {
      "type": "string",
      "const": "xhigh"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_sha256",
          "decision",
          "scope_claim",
          "source_locations",
          "rationale",
          "candidates",
          "evidence_complete"
        ],
        "properties": {
          "case_id": {"type": "string"},
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision": {
            "type": "string",
            "enum": [
              "recommend_change",
              "no_change",
              "unsupported",
              "inconclusive"
            ]
          },
          "scope_claim": {
            "type": "string",
            "enum": ["whole_case", "finding_only", "none"]
          },
          "source_locations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "rationale": {"type": "string"},
          "candidates": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate_id",
                "path",
                "formal_status",
                "measurement_status",
                "final_state",
                "evidence_paths"
              ],
              "properties": {
                "candidate_id": {"type": "string"},
                "path": {"type": "string"},
                "formal_status": {
                  "type": "string",
                  "enum": [
                    "formal_passed",
                    "formal_failed",
                    "formal_inconclusive",
                    "not_run"
                  ]
                },
                "measurement_status": {
                  "type": "string",
                  "enum": ["measured", "not_run", "not_applicable"]
                },
                "final_state": {
                  "type": "string",
                  "enum": [
                    "measured_improvement",
                    "synthesis_handles",
                    "flow_dependent",
                    "regression",
                    "unproven",
                    "not_applicable"
                  ]
                },
                "evidence_paths": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "evidence_complete": {"type": "boolean"}
        }
      }
    }
  }
}
